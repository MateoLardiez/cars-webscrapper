{
  "name": "cars-webscrapper",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace @cars-webscrapper/backend run dev\" \"npm --workspace @cars-webscrapper/frontend run dev\"",
    "build": "npm --workspaces run build",
    "lint": "npm --workspaces run lint",
    "test": "npm --workspaces run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
