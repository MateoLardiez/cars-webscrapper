{
  "compilerOptions": {
    // Entorno: Vite empaqueta el código, así que usamos resolución "bundler"
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "noEmit": true,

    // Alias usado por shadcn/ui (@/components, @/lib)
    "paths": {
      "@/*": ["./src/*"],
      "@cars-webscrapper/shared": ["../shared/types.ts"]
    },

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts"]
}
